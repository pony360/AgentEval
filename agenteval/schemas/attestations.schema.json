{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/schemas/v1/attestations.schema.json",
  "title": "AgentEval attestations file",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestations"
      ],
      "properties": {
        "attestations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attestation"
          }
        }
      }
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attestation"
      }
    }
  ],
  "$defs": {
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "attested_by",
        "attested_at",
        "evidence"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Z]{2,6}(-[A-Z0-9]{2,8})+$"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "default": "*",
          "description": "Asset ID, or \"*\" for every asset the rule applies to."
        },
        "attested_by": {
          "type": "string",
          "minLength": 1
        },
        "attested_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ].*)?$",
          "description": "ISO date (YYYY-MM-DD). Used for max_age_days checks."
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "description": "Keys must match the rule's attestation.evidence_required. Prefer links or ticket IDs over pasted content."
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
